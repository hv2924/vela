fn isEven(value : int) -> bool {
  return value % 2 == 0
}

fn double(value : int) -> int {
  return value * 2
}

fn greaterThanTen(value : int) -> bool {
  return value > 10
}

let numbers : list[int] =
  list(1, 2, 3, 4, 5, 6, 7)

let result : int =
  weave(
    numbers,
    filter(isEven),
    map(double),
    find(greaterThanTen)
  )

print(result)